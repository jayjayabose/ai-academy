{
  "extends": "./tsconfig.json",
  // `jest.config.ts` is excluded for a reason that is invisible until it bites:
  // it is the only .ts file outside src/, so including it makes TypeScript infer
  // a common root of apps/api rather than apps/api/src. dist/main.js silently
  // becomes dist/src/main.js, and `start:prod` (node dist/main) stops resolving.
  "exclude": ["node_modules", "test", "dist", "jest.config.ts", "**/*spec.ts"]
}
