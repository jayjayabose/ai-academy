# Copy to .env.local and adjust. .env.local is gitignored; this template is committed.
#
# Single source of truth: docker-compose.yml, the NestJS app, and the Umzug
# migration runner all read these same variables. Do not duplicate them elsewhere.

# --- Postgres -----------------------------------------------------------------
# Compose maps container 5432 -> host DB_PORT.
# 5433 (not 5432) because a Homebrew postgres@14 already owns 5432 on this machine.
DB_HOST=localhost
DB_PORT=5433
DB_USER=crm
DB_PASSWORD=crm_local_dev
DB_NAME=crm_dev
DB_TEST_NAME=crm_test

# --- API ----------------------------------------------------------------------
PORT=3000
NODE_ENV=development

# --- Day 2: LLM ---------------------------------------------------------------
# Optional until Day 2. Boot validation treats this as optional while NODE_ENV
# is development; it becomes required when the AI features land.
OPENROUTER_API_KEY=
